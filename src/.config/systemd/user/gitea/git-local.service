[Unit]
Description=Git Local (Gitea)
# User units cannot depend on the system mount unit for @ROOT@,
# so wait for the mount point before starting (see ExecStartPre).
After=network.target


[Service]
# Wait up to 60 seconds for the external drive to be mounted at @ROOT@.
ExecStartPre=/usr/bin/timeout 60 /bin/sh -c 'until mountpoint -q @ROOT@; do sleep 1; done'
ExecStart=/usr/bin/gitea web --config @ROOT@/git.local/config/config.ini
Restart=always
WorkingDirectory=@ROOT@/git.local
Environment=HOME=/home/boss USER=boss

[Install]
WantedBy=default.target
